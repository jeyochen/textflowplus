<Window x:Class="TextFlow.ReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="替换" Height="200" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="查找内容 (_F):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" x:Name="FindTextBox" Height="25" KeyDown="FindTextBox_KeyDown"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="替换为 (_R):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" x:Name="ReplaceTextBox" Height="25" KeyDown="ReplaceTextBox_KeyDown"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="MatchCaseCheckBox" Content="区分大小写" Margin="0,0,20,0"/>
            <CheckBox x:Name="MatchWholeWordCheckBox" Content="全字匹配"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="查找下一个" Width="100" Height="25" Margin="0,0,10,0" Click="FindNext_Click"/>
            <Button Content="替换" Width="80" Height="25" Margin="0,0,10,0" Click="Replace_Click"/>
            <Button Content="全部替换" Width="80" Height="25" Margin="0,0,10,0" Click="ReplaceAll_Click"/>
            <Button Content="取消" Width="80" Height="25" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
