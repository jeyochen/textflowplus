<Window x:Class="TextFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextFlow"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="TextFlow" Height="450" Width="800"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top">
            <!-- 文件菜单 -->
            <MenuItem Header="文件 (_F)">
                <MenuItem Header="新建 (_N)" InputGestureText="Ctrl+N" Click="NewFile_Click"/>
                <MenuItem Header="打开 (_O)" InputGestureText="Ctrl+O" Click="OpenFile_Click"/>
                <Separator/>
                <MenuItem Header="保存 (_S)" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="另存为 (_A)" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="关闭 (_W)" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <Separator/>
                <MenuItem Header="退出 (_X)" Click="Exit_Click"/>
            </MenuItem>

            <!-- 编辑菜单 -->
            <MenuItem Header="编辑 (_E)">
                <MenuItem Header="撤销 (_U)" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="重做 (_R)" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="剪切 (_T)" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                <MenuItem Header="复制 (_C)" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem Header="粘贴 (_P)" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <Separator/>
                <MenuItem Header="全选 (_A)" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                <Separator/>
                <MenuItem Header="查找 (_F)" InputGestureText="Ctrl+F" Click="Find_Click"/>
                <MenuItem Header="替换 (_R)" InputGestureText="Ctrl+H" Click="Replace_Click"/>
                <Separator/>
                <MenuItem Header="格式化代码 (_K)" InputGestureText="Ctrl+K" Click="FormatCode_Click"/>
                <Separator/>
                <MenuItem Header="显示制表符" x:Name="ShowTabsMenuItem" IsCheckable="True" Click="ShowTabs_Click"/>
                <MenuItem Header="显示空格" x:Name="ShowSpacesMenuItem" IsCheckable="True" Click="ShowSpaces_Click"/>
                <MenuItem Header="显示行尾标记" x:Name="ShowEndOfLineMenuItem" IsCheckable="True" Click="ShowEndOfLine_Click"/>
            </MenuItem>

            <!-- 编码菜单 -->
            <MenuItem Header="编码 (_C)">
                <MenuItem Header="当前编码" x:Name="CurrentEncodingMenuItem">
                    <MenuItem Header="自动检测" IsCheckable="True" IsChecked="True"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="以 GB2312 编码保存" Click="SaveAsAnsi_Click"/>
                <MenuItem Header="以 UTF-8 编码保存" Click="SaveAsUtf8_Click"/>
                <MenuItem Header="以 UTF-8 with BOM 编码保存" Click="SaveAsUtf8Bom_Click"/>
                <Separator/>
                <MenuItem Header="转换为 GB2312" Click="ConvertToAnsi_Click"/>
                <MenuItem Header="转换为 UTF-8" Click="ConvertToUtf8_Click"/>
                <MenuItem Header="转换为 UTF-8 with BOM" Click="ConvertToUtf8Bom_Click"/>
            </MenuItem>

            <!-- 语言菜单 -->
            <MenuItem Header="语言 (_L)">
                <MenuItem Header="C/C++" Tag="C++" Click="Language_Click" IsCheckable="True"/>
                <MenuItem Header="C#" Tag="C#" Click="Language_Click" IsCheckable="True"/>
                <Separator/>
                <MenuItem Header="Python" Tag="Python" Click="Language_Click" IsCheckable="True"/>
                <Separator/>
                <MenuItem Header="JavaScript" Tag="JavaScript" Click="Language_Click" IsCheckable="True"/>
                <MenuItem Header="XAML" Tag="XAML" Click="Language_Click" IsCheckable="True"/>
                <MenuItem Header="YAML" Tag="YAML" Click="Language_Click" IsCheckable="True"/>
                <Separator/>
                <MenuItem Header="纯文本" Tag="PlainText" Click="Language_Click" IsCheckable="True"/>
            </MenuItem>

            <!-- JSON 菜单 -->
            <MenuItem Header="JSON (_J)">
                <MenuItem Header="JSON 格式化" Click="JsonFormat_Click"/>
                <MenuItem Header="JSON 压缩" Click="JsonMinify_Click"/>
                <Separator/>
                <MenuItem Header="JSON 语法检查" Click="JsonValidate_Click"/>
                <Separator/>
                <MenuItem Header="JSON 语法高亮" Tag="JSON" Click="Language_Click" IsCheckable="True"/>
            </MenuItem>

            <!-- 视图菜单 -->
            <MenuItem Header="视图 (_V)">
                <MenuItem Header="放大 (_I)" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem Header="缩小 (_O)" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                <MenuItem Header="重置缩放 (_R)" InputGestureText="Ctrl+0" Click="ZoomReset_Click"/>
                <Separator/>
                <MenuItem Header="工具栏" IsCheckable="True" IsChecked="True" Click="Toolbar_Click"/>
                <MenuItem Header="状态栏" IsCheckable="True" IsChecked="True" Click="Statusbar_Click"/>
            </MenuItem>

            <!-- 关于菜单 -->
            <MenuItem Header="关于 (_A)">
                <MenuItem Header="关于 TextFlow" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="MainToolBar">
                <Button ToolTip="新建" Click="NewFile_Click">
                    <TextBlock Text="📄" FontSize="16"/>
                </Button>
                <Button ToolTip="打开" Click="OpenFile_Click">
                    <TextBlock Text="📂" FontSize="16"/>
                </Button>
                <Button ToolTip="保存" Click="Save_Click">
                    <TextBlock Text="💾" FontSize="16"/>
                </Button>
                <Separator/>
                <Button ToolTip="撤销" Click="Undo_Click">
                    <TextBlock Text="↩️" FontSize="16"/>
                </Button>
                <Button ToolTip="重做" Click="Redo_Click">
                    <TextBlock Text="↪️" FontSize="16"/>
                </Button>
                <Separator/>
                <Button ToolTip="剪切" Click="Cut_Click">
                    <TextBlock Text="✂️" FontSize="16"/>
                </Button>
                <Button ToolTip="复制" Click="Copy_Click">
                    <TextBlock Text="📋" FontSize="16"/>
                </Button>
                <Button ToolTip="粘贴" Click="Paste_Click">
                    <TextBlock Text="📝" FontSize="16"/>
                </Button>
                <Separator/>
                <Button ToolTip="查找" Click="Find_Click">
                    <TextBlock Text="🔍" FontSize="16"/>
                </Button>
                <Button ToolTip="替换" Click="Replace_Click">
                    <TextBlock Text="🔄" FontSize="16"/>
                </Button>
                <Separator/>
                <Button ToolTip="格式化代码" Click="FormatCode_Click">
                    <TextBlock Text="📐" FontSize="16"/>
                </Button>
                <Separator/>
                <Button ToolTip="分栏对比" Click="SplitView_Click">
                    <TextBlock Text="📊" FontSize="16"/>
                </Button>
                <Separator/>
                <Button ToolTip="放大" Click="ZoomIn_Click">
                    <TextBlock Text="🔍+" FontSize="14"/>
                </Button>
                <Button ToolTip="缩小" Click="ZoomOut_Click">
                    <TextBlock Text="🔍-" FontSize="14"/>
                </Button>
                <Separator/>
                <ComboBox x:Name="FontFamilyComboBox" Width="120" SelectionChanged="FontFamilyComboBox_SelectionChanged">
                    <ComboBoxItem Content="Consolas"/>
                    <ComboBoxItem Content="Courier New"/>
                    <ComboBoxItem Content="Lucida Console"/>
                    <ComboBoxItem Content="Source Code Pro"/>
                    <ComboBoxItem Content="Fira Code"/>
                    <ComboBoxItem Content="JetBrains Mono"/>
                    <ComboBoxItem Content="Cascadia Code"/>
                    <ComboBoxItem Content="宋体"/>
                    <ComboBoxItem Content="微软雅黑"/>
                    <ComboBoxItem Content="等线"/>
                </ComboBox>
                <Separator/>
                <ComboBox x:Name="FontSizeComboBox" Width="60" IsEditable="True" SelectionChanged="FontSizeComboBox_SelectionChanged">
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="18"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="22"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="28"/>
                    <ComboBoxItem Content="32"/>
                    <ComboBoxItem Content="36"/>
                    <ComboBoxItem Content="48"/>
                    <ComboBoxItem Content="72"/>
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <!-- 主内容区域：分栏视图 + 状态栏 -->
        <Grid DockPanel.Dock="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 分栏视图容器 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" x:Name="LeftColumn"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" x:Name="RightColumn"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧标签页容器（默认占满整个区域） -->
                <Grid Grid.Column="0" Grid.ColumnSpan="3" x:Name="LeftPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TabControl x:Name="FileTabControl" Grid.Row="0" SelectionChanged="FileTabControl_SelectionChanged">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" IsItemsHost="True"/>
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                    Grid.Row="1"
                                                    ContentSource="SelectedContent"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Grid x:Name="PART_Grid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4,4,0,0"
                                                        Margin="2,0,2,0">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Margin="5,5,0,5"/>
                                                </Border>
                                                <Button Grid.Column="1"
                                                        x:Name="CloseButton"
                                                        Content="×"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Padding="4,0,4,2"
                                                        Margin="2,4,4,4"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="CloseTabButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="3"
                                                                    Padding="4,0,4,2">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="#C0C0C0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="PART_Header" Property="TextElement.FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                    </TabControl>
                    <!-- 左侧状态栏 -->
                    <StatusBar x:Name="LeftStatusBar" Grid.Row="1">
                        <StatusBarItem>
                            <TextBlock x:Name="LeftStatusText" Text="就绪"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="LeftFilePathText" Text=""/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="LeftCursorPosText" Text="行：1, 列：1"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="LeftLineCountText" Text="行数：0"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="LeftByteCountText" Text="字节：0"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="LeftEncodingText" Text="编码：UTF-8"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem HorizontalAlignment="Right">
                            <TextBlock x:Name="LeftZoomText" Text="100%"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem HorizontalAlignment="Right">
                            <TextBlock Text="TextFlow v1.0"/>
                        </StatusBarItem>
                    </StatusBar>
                </Grid>

                <!-- 分隔条 -->
                <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="5"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#CCCCCC" Visibility="Collapsed">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="#CCCCCC" CornerRadius="2" Width="5">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⋮" FontSize="10" Foreground="#666666" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- 右侧标签页容器 -->
                <Grid Grid.Column="2" Visibility="Collapsed" x:Name="RightPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TabControl x:Name="RightTabControl" Grid.Row="0" SelectionChanged="RightTabControl_SelectionChanged">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" IsItemsHost="True"/>
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                    Grid.Row="1"
                                                    ContentSource="SelectedContent"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Grid x:Name="PART_Grid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4,4,0,0"
                                                        Margin="2,0,2,0">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Margin="5,5,0,5"/>
                                                </Border>
                                                <Button Grid.Column="1"
                                                        x:Name="CloseButton"
                                                        Content="×"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Padding="4,0,4,2"
                                                        Margin="2,4,4,4"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="CloseTabButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="3"
                                                                    Padding="4,0,4,2">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="#C0C0C0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="PART_Header" Property="TextElement.FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                    </TabControl>
                    <!-- 右侧状态栏 -->
                    <StatusBar x:Name="RightStatusBar" Grid.Row="1" Visibility="Collapsed">
                        <StatusBarItem>
                            <TextBlock x:Name="RightStatusText" Text="就绪"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="RightFilePathText" Text=""/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="RightCursorPosText" Text="行：1, 列：1"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="RightLineCountText" Text="行数：0"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="RightByteCountText" Text="字节：0"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="RightEncodingText" Text="编码：UTF-8"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem HorizontalAlignment="Right">
                            <TextBlock x:Name="RightZoomText" Text="100%"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem HorizontalAlignment="Right">
                            <TextBlock Text="TextFlow v1.0"/>
                        </StatusBarItem>
                    </StatusBar>
                </Grid>
            </Grid>
            <!-- 主状态栏（用于视图菜单切换） -->
            <StatusBar x:Name="MainStatusBar" Grid.Row="1" Visibility="Collapsed">
                <StatusBarItem>
                    <TextBlock Text="主状态栏"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>
