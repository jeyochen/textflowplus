<Window x:Class="TextFlow.FindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查找" Height="150" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="查找内容 (_F):" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="FindTextBox" Width="250" Height="25" Margin="0,0,0,10"
                 KeyDown="FindTextBox_KeyDown"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="MatchCaseCheckBox" Content="区分大小写" Margin="0,0,20,0"/>
            <CheckBox x:Name="MatchWholeWordCheckBox" Content="全字匹配"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="查找下一个" Width="100" Height="25" Margin="0,0,10,0" Click="FindNext_Click"/>
            <Button Content="取消" Width="80" Height="25" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
