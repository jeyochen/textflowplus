<SyntaxDefinition name="TypeScript" extensions=".ts;.tsx;.mts;.cts" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Comment" foreground="#008000" />
	<Color name="String" foreground="#A31515" />
	<Color name="Keyword" foreground="#0000FF" />
	<Color name="TypeKeyword" foreground="#0000FF" />
	<Color name="Number" foreground="#098658" />
	<Color name="Type" foreground="#2B91AF" />
	<Color name="Function" foreground="#795E26" />
	<Color name="Variable" foreground="#001080" />
	<Color name="Operator" foreground="#000000" />
	<Color name="Punctuation" foreground="#000000" />
	<Color name="Class" foreground="#267F99" />
	<Color name="Interface" foreground="#267F99" />
	<Color name="Property" foreground="#001080" />
	<Color name="Method" foreground="#795E26" />
	<Color name="Parameter" foreground="#001080" />
	<Color name="Decorator" foreground="#0000FF" />
	<Color name="Boolean" foreground="#0000FF" />
	<Color name="Null" foreground="#0000FF" />
	<Color name="Template" foreground="#098658" />

	<RuleSet>
		<!-- Comments -->
		<Span color="Comment">
			<Begin>//</Begin>
		</Span>
		<Span color="Comment" multiline="true">
			<Begin>/\*</Begin>
			<End>\*/</End>
		</Span>

		<!-- Strings -->
		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
			<RuleSet>
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>
		<Span color="String">
			<Begin>'</Begin>
			<End>'</End>
			<RuleSet>
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>
		<Span color="String">
			<Begin>`</Begin>
			<End>`</End>
			<RuleSet>
				<Span begin="\${" end="}"/>
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>

		<!-- Numbers -->
		<Rule color="Number">\b0[xX][0-9a-fA-F]+\b</Rule>
		<Rule color="Number">\b[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?\b</Rule>

		<!-- TypeScript Keywords -->
		<Rule color="TypeKeyword">\b(type|interface|enum|namespace|module|declare|implements|readonly|abstract|as|const|let|var|function|class|extends|new|this|super|import|export|from|return|yield|async|await|of|in|instanceof|typeof|keyof|infer|extends|never|void|any|unknown|object|string|number|boolean|symbol|bigint|undefined|null|true|false|get|set|require|module|exports)\b</Rule>

		<!-- Boolean and Null -->
		<Rule color="Boolean">\b(true|false)\b</Rule>
		<Rule color="Null">\bnull\b</Rule>
		<Rule color="Null">\bundefined\b</Rule>

		<!-- Operators -->
		<Rule color="Operator">===|!==|==|=|&lt;=|&gt;=|&lt;&lt;|&gt;&gt;|&gt;&gt;&gt;|\.\.\.|\?\?|\?\.|=&gt;|[-+*/%&amp;|^~!&lt;&gt;?:]</Rule>

		<!-- Punctuation -->
		<Rule color="Punctuation">[{}\[\]();,.]</Rule>

		<!-- Type Annotations -->
		<Span color="Type">
			<Begin>:</Begin>
			<End>(?=[\s\)\];,{}=])</End>
			<RuleSet>
				<Rule color="Type">\b[A-Z][a-zA-Z0-9_]*\b</Rule>
				<Rule color="TypeKeyword">\b(string|number|boolean|any|void|null|undefined|never|unknown|object|symbol|bigint)\b</Rule>
				<Rule color="Operator">[|&amp;&lt;&gt;\[\],]</Rule>
			</RuleSet>
		</Span>

		<!-- Identifiers -->
		<Rule color="Function">\b[a-zA-Z_][a-zA-Z0-9_]*\s*(?=\()</Rule>
		<Rule color="Class">\b[A-Z][a-zA-Z0-9_]*\b</Rule>
		<Rule color="Interface">\bI[A-Z][a-zA-Z0-9_]*\b</Rule>
	</RuleSet>
</SyntaxDefinition>
