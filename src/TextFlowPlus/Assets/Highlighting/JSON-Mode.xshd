<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="JSON"
                  extensions=".json"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

    <Color name="Key" foreground="#0000FF" fontWeight="bold" />
    <Color name="StringValue" foreground="#A05000" />
    <Color name="Keyword" foreground="#0000FF" fontWeight="bold" />
    <Color name="Number" foreground="#008000" />
    <Color name="Bracket" foreground="#000000" />
    <Color name="Punctuation" foreground="#000000" />

    <RuleSet>
        <!-- Key: string followed by colon (key in JSON) -->
        <Span color="Key">
            <Begin>\"(?=[^"]*\":\s*)</Begin>
            <End>\"</End>
        </Span>

        <!-- String value: regular double-quoted strings -->
        <Span color="StringValue">
            <Begin>"</Begin>
            <End>"</End>
        </Span>

        <!-- Boolean and null keywords -->
        <Keywords color="Keyword">
            <Word>true</Word>
            <Word>false</Word>
            <Word>null</Word>
        </Keywords>

        <!-- Numbers -->
        <Rule color="Number">-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?</Rule>

        <!-- Brackets -->
        <Rule color="Bracket">[\{\}\[\]]</Rule>

        <!-- Colons and commas -->
        <Rule color="Punctuation">[:,]</Rule>
    </RuleSet>
</SyntaxDefinition>
