<Window
    Height="700"
    MinHeight="500"
    MinWidth="1000"
    Title="文件对比"
    Width="1400"
    WindowStartupLocation="CenterOwner"
    x:Class="TextFlowPlus.Views.FileCompareDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avaloniaedit="using:AvaloniaEdit">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <Button
                Content="重新对比"
                Width="80"
                Margin="0,0,5,0"
                x:Name="RecompareButton" />
            <Button
                Content="合并所有（左→右）"
                Width="150"
                Margin="0,0,5,0"
                HorizontalContentAlignment="Center"
                x:Name="MergeAllLeftToRightButton" />
            <Button
                Content="合并所有（右→左）"
                Width="150"
                Margin="0,0,5,0"
                HorizontalContentAlignment="Center"
                x:Name="MergeAllRightToLeftButton" />
            <Separator
                Width="1"
                Margin="5,0"
                Background="Gray" />
            <TextBlock
                Margin="0,0,5,0"
                Text="差异数量："
                VerticalAlignment="Center" />
            <TextBlock
                FontWeight="Bold"
                MinWidth="30"
                Text="0"
                VerticalAlignment="Center"
                x:Name="DiffCountText" />
        </StackPanel>

        <!-- 主内容区域：左右对比 + 差异列表 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <!-- 左侧文件 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 左侧文件选择 -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <TextBox
                        Width="400"
                        Margin="0,0,5,0"
                        IsReadOnly="True"
                        VerticalContentAlignment="Center"
                        x:Name="LeftFileTextBox" />
                    <Button
                        Content="浏览..."
                        Width="60"
                        HorizontalContentAlignment="Center"
                        x:Name="BrowseLeftButton" />
                </StackPanel>

                <!-- 左侧编辑区 -->
                <avaloniaedit:TextEditor
                    Grid.Row="1"
                    FontFamily="Consolas"
                    FontSize="14"
                    ShowLineNumbers="True"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    x:Name="LeftTextEditor" />
            </Grid>

            <!-- 分隔条 -->
            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                Background="Gray" />

            <!-- 右侧文件 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 右侧文件选择 -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <TextBox
                        Width="400"
                        Margin="0,0,5,0"
                        IsReadOnly="True"
                        VerticalContentAlignment="Center"
                        x:Name="RightFileTextBox" />
                    <Button
                        Content="浏览..."
                        Width="60"
                        HorizontalContentAlignment="Center"
                        x:Name="BrowseRightButton" />
                </StackPanel>

                <!-- 右侧编辑区 -->
                <avaloniaedit:TextEditor
                    Grid.Row="1"
                    FontFamily="Consolas"
                    FontSize="14"
                    ShowLineNumbers="True"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    x:Name="RightTextEditor" />
            </Grid>

            <!-- 右侧分隔条 -->
            <GridSplitter
                Grid.Column="3"
                Width="5"
                HorizontalAlignment="Stretch"
                Background="Gray" />

            <!-- 差异列表面板 -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    Text="差异列表" />
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="DiffListPanel"
                        Orientation="Vertical" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="5">
            <TextBlock
                Text="就绪"
                x:Name="StatusText" />
        </Border>
    </Grid>
</Window>
